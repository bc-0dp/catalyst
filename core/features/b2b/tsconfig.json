{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "trackFieldUsage": false,
        "shouldCheckForColocatedFragments": false,
        "schemas": [
          {
            "name": "bigcommerce-b2b",
            "schema": "./bigcommerce-b2b.graphql",
            "tadaOutputLocation": "./bigcommerce-b2b-graphql.d.ts"
          }
        ]
      }
    ]
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
